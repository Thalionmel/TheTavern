{
  "name": "the-tavern",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A private tabletop campaign room with live, permission-aware dice rolls.",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env --watch server.mjs",
    "dev:cloudflare": "wrangler dev --ip 127.0.0.1 --port 8787",
    "build:cloudflare": "wrangler deploy --dry-run --outdir work/cloudflare-build",
    "deploy:cloudflare": "wrangler deploy",
    "test": "npm run build:cloudflare && node --test"
  },
  "devDependencies": {
    "miniflare": "5.20261110.1-beta",
    "wrangler": "4.160.1"
  }
}
